# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="En Yakın Şarj"

# ── Veritabanı ──
# Docker / Coolify: bağlantı POSTGRES_USER, POSTGRES_PASSWORD ve POSTGRES_DB değerlerinden otomatik kurulur
# (DATABASE_URL gerekmez; şifrede özel karakter kullanılabilir).
# POSTGRES_PASSWORD'u sonradan değiştirebilirsiniz: migrate servisi, veritabanındaki şifreyi yeni değerle
# otomatik eşitler. POSTGRES_USER ve POSTGRES_DB ise veritabanı ilk oluşturulduktan sonra DEĞİŞTİRİLMEMELİ:
# PostgreSQL bunları yalnızca volume ilk oluşturulurken kurar ("role ... does not exist" hatası buradan gelir).
# Yerel geliştirme: aşağıdaki DATABASE_URL kullanılır.
POSTGRES_USER=enyakinsarj
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enyakinsarj
DATABASE_URL=postgresql://enyakinsarj:change-me@localhost:5432/enyakinsarj?schema=public

# ── Güvenlik ──
# Oturum çerezi imzalama + sosyal medya kimlik bilgisi şifreleme anahtarı (en az 32 karakter)
# Üretmek için: openssl rand -base64 48
APP_SECRET=
# Zamanlanmış görevler (/api/cron) için gizli anahtar
CRON_SECRET=

# İlk yönetici hesabı (npm run db:seed ile oluşturulur)
ADMIN_EMAIL=admin@enyakinsarj.com.tr
ADMIN_PASSWORD=
ADMIN_NAME="Yönetici"

# ── Şarjağ API (https://console.sarjag.com) ──
# Anahtar YALNIZCA sunucuda kullanılır; NEXT_PUBLIC_ öneki vermeyin.
SARJAG_API_KEY=
SARJAG_API_URL=https://console.sarjag.com/api/v1
# İstasyon senkronu kaç saatte bir yapılsın (cron her çalıştığında kontrol edilir)
SYNC_INTERVAL_HOURS=24

# ── Yapay zekâ ──
# Arama kutusu, blog yazısı üretimi, SEO ve sosyal medya metinleri için. İki seçenek:
#
# 1) Ücretsiz servis (OpenAI uyumlu). AI_PROVIDER + AI_API_KEY yeterlidir:
#      gemini      → anahtar: https://aistudio.google.com/apikey      (varsayılan model: gemini-flash-latest)
#      groq        → anahtar: https://console.groq.com/keys           (varsayılan model: openai/gpt-oss-120b)
#      openrouter  → anahtar: https://openrouter.ai/keys              (AI_MODEL zorunlu; ücretsiz modeller ":free" ile biter)
#      custom      → AI_BASE_URL + AI_MODEL ile herhangi bir OpenAI uyumlu uç nokta
#    Ücretsiz katmanların günlük kotası ve model listesi sağlayıcıya göre değişir ve sık güncellenir;
#    model bulunamazsa AI_MODEL'i sağlayıcının güncel listesinden seçin.
# 2) Claude: AI_PROVIDER=anthropic + ANTHROPIC_API_KEY (ücretli).
#
# AI_PROVIDER boşsa: AI_API_KEY varsa gemini, yoksa ANTHROPIC_API_KEY ile Claude kullanılır.
AI_PROVIDER=gemini
AI_API_KEY=
# Sağlayıcının varsayılan modelini değiştirmek için (boş bırakılabilir)
AI_MODEL=
# Yalnızca AI_PROVIDER=custom için
AI_BASE_URL=
# Yanıt üst sınırı (jeton). Ücretsiz katmanda dakikalık sınıra takılırsanız düşürün.
AI_MAX_TOKENS=
ANTHROPIC_API_KEY=

# ── Oracle Cloud Object Storage (S3 uyumlu API) ──
# Konsol → Profil → Customer Secret Keys ile Access/Secret key üretin.
OCI_NAMESPACE=
OCI_REGION=eu-frankfurt-1
OCI_BUCKET=enyakinsarj-media
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
# Görsellerin herkese açık adresi (boş bırakılırsa public bucket URL'i kullanılır)
# Örn: https://objectstorage.eu-frankfurt-1.oraclecloud.com/n/<namespace>/b/<bucket>/o
OCI_PUBLIC_BASE_URL=

# ── Şarjağ mobil uygulamaları (footer) ──
NEXT_PUBLIC_SARJAG_APP_STORE_URL=https://apps.apple.com/tr/app/%C5%9Farja%C4%9F-t%C3%BCm-%C5%9Farj-i-stasyonlar%C4%B1/id6834798761
NEXT_PUBLIC_SARJAG_PLAY_STORE_URL=
